# Everything is optional. With nothing set, `npm run dev` runs in mock mode on an
# in-memory database: no API calls, no cost.

# Live mode: Claude writes the answers and decides when to call tools.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Your Supabase (or any Postgres with pgvector) database. Run `npm run db:setup` once.
# Supabase: Project settings → Database → Connection string (session pooler).
DATABASE_URL=

# Real embeddings instead of the local word-hashing embedder. Both must be set.
# Re-run `npm run ingest` after changing them.
VOYAGE_API_KEY=
VOYAGE_MODEL=
