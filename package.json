{
  "name": "ai-support-agent",
  "version": "0.1.0",
  "private": true,
  "description": "RAG support agent demo: Next.js + Supabase pgvector + Claude, with cited answers, refusals, two tools, tests and an eval.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "db:setup": "tsx --env-file-if-exists=.env scripts/db-setup.ts",
    "typecheck": "tsc --noEmit",
    "make:pdf": "tsx scripts/make-sample-pdf.ts",
    "screenshots": "next build && tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
